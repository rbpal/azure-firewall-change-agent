{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Firewall ticket",
  "description": "Synthetic stand-in for a ServiceNow firewall requested item. The catalog item says add or remove; the addresses say egress or inbound. An inbound ticket's port is the port the partner connects to and the port on the internal host. Checks shape only; code checks meaning (address plan, routing, existing rules).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number", "item", "state", "requested_for", "opened",
    "environments", "dr_site_built", "change_sites",
    "sources", "destination", "protocol", "ports", "partner",
    "justification", "approvals", "assigned_to"
  ],
  "properties": {
    "number": { "type": "string", "pattern": "^RITM[0-9]{7}$" },
    "item": { "enum": ["Firewall Change Request", "Firewall Rule Removal"] },
    "state": { "enum": ["pending", "approved", "rejected"] },
    "requested_for": { "type": "string", "minLength": 1 },
    "opened": { "type": "string", "format": "date-time" },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/environment" }
    },
    "dr_site_built": {
      "description": "Per environment: does the application's DR site exist? A fact about the landing zone, checked against the network. It does not put DR in scope.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/environment" },
      "additionalProperties": { "type": "boolean" }
    },
    "change_sites": {
      "description": "Per environment: the sites this ticket changes, primary, dr or both. Only these files are edited; an existing DR site is not in scope unless listed here.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/environment" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/site" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "allOf": [{ "$ref": "#/$defs/address" }, { "not": { "required": ["url"] } }] }
    },
    "destination": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/address" }
    },
    "protocol": { "enum": ["TCP", "UDP", "ICMP", "Any", "HTTP", "HTTPS"] },
    "ports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/port" }
    },
    "existing_rule": {
      "description": "Firewall Rule Removal only, optional: the rule name if the requester knows it. The workflow still matches the flow itself.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "partner": {
      "enum": [
        "Northwind Traders", "Fabrikam", "Woodgrove Bank", "Litware", "Fourth Coffee",
        "Tailspin", "Proseware", "Lamna Healthcare", "Adventure Works", "Wingtip Toys",
        null
      ]
    },
    "justification": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "approvals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/approval" },
      "allOf": [
        { "contains": { "properties": { "group": { "const": "security" } } } },
        { "contains": { "properties": { "group": { "const": "network" } } } },
        { "contains": { "properties": { "group": { "const": "project" } } } }
      ]
    },
    "assigned_to": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "$comment": "Inbound: no source is internal. Internal means an Azure address (environment), an on-prem CIDR (location) or an on-prem IP group. DNAT takes TCP or UDP only.",
      "if": {
        "properties": {
          "sources": { "not": { "contains": { "anyOf": [
            { "required": ["environment"] },
            { "required": ["location"] },
            { "required": ["ip_group"], "properties": { "ip_group": { "pattern": "^ipg-onprem-" } } }
          ] } } }
        }
      },
      "then": { "properties": { "protocol": { "enum": ["TCP", "UDP"] } } }
    },
    {
      "if": { "properties": { "item": { "const": "Firewall Change Request" } } },
      "then": { "not": { "required": ["existing_rule"] } }
    },
    {
      "if": { "properties": { "state": { "const": "approved" } } },
      "then": {
        "properties": {
          "approvals": { "items": { "properties": { "state": { "const": "approved" } } } }
        }
      }
    }
  ],
  "$defs": {
    "environment": { "enum": ["lab", "dev", "stage", "prod"] },
    "site": { "enum": ["primary", "dr"] },
    "address": {
      "description": "Exactly one of cidr, ip_group, fqdn, url or vnet. The type is part of the approval: a cidr approves that CIDR, an ip_group approves that named group, and one is never swapped for the other, even when the group holds the same addresses (STD-COLL-03). environment and site appear together, on the internal Azure side of the flow. location (onprem-primary or onprem-secondary) marks an on-prem CIDR, and never appears with environment or site; an on-prem IP group names its data centre itself and takes no location. url is for a destination only: the address a requester pasted, with scheme, optional port and path. The rule uses its hostname and port; the path stays on the ticket, but no rule matches on it. vnet (with an optional subnet) records a network the requester named without an address; the ticket is kept, but intake sends it to engineer review, because no rule can be written until an edit gives the CIDR or IP group.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cidr": {
          "type": "string",
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$"
        },
        "ip_group": { "type": "string", "pattern": "^ipg-([a-z]{4}-(lab|dev|stage|prod)(-dr)?|partner-[a-z]+|onprem-(primary|secondary))$" },
        "fqdn": {
          "type": "string",
          "pattern": "^(\\*|(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z]{2,63})$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}(:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(/[^\\s]*)?$"
        },
        "environment": { "$ref": "#/$defs/environment" },
        "site": { "$ref": "#/$defs/site" },
        "location": { "enum": ["onprem-primary", "onprem-secondary"] },
        "vnet": { "type": "string", "pattern": "^vnet-[a-z0-9-]{1,60}$" },
        "subnet": { "type": "string", "pattern": "^snet-[a-z0-9-]{1,60}$" }
      },
      "if": { "required": ["location"] },
      "then": { "required": ["cidr"], "not": { "anyOf": [{ "required": ["environment"] }, { "required": ["site"] }] } },
      "oneOf": [
        { "required": ["cidr"] },
        { "required": ["ip_group"] },
        { "required": ["fqdn"] },
        { "required": ["url"] },
        { "required": ["vnet"] }
      ],
      "dependentRequired": {
        "environment": ["site"],
        "site": ["environment"],
        "subnet": ["vnet"]
      }
    },
    "port": {
      "description": "A single port, a range, or * (any). Code checks the 1-65535 bound and that a range runs low to high.",
      "type": "string",
      "pattern": "^(\\*|[1-9][0-9]{0,4}(-[1-9][0-9]{0,4})?)$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "approver", "state"],
      "properties": {
        "group": { "enum": ["security", "network", "project"] },
        "approver": { "type": "string", "minLength": 1 },
        "state": { "enum": ["pending", "approved", "rejected"] }
      }
    }
  }
}
