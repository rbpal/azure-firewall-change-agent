// Daily volume, reliability and speed of runs Foundry received. A change here
// is a trend; it does not show whether the drafts became more or less correct.
// @include agent_runs
agent_runs
| summarize runs = count(), failed = countif(Success == false),
            p50_seconds = round(percentile(DurationMs, 50) / 1000.0, 1),
            p95_seconds = round(percentile(DurationMs, 95) / 1000.0, 1)
    by bin(TimeGenerated, 1d)
| extend failure_rate_percent = round(100.0 * failed / runs, 1)
| order by TimeGenerated asc
